# Скопируйте в .env. Сам .env в git не попадает.

# Уведомления в Telegram (необязательно: без них алерты печатаются в консоль)
BOT_TOKEN=
# Ваш Telegram ID (узнать у @userinfobot) или ID группы
CHAT_ID=

# Пауза между запросами к одному сайту, секунды (не делайте меньше 1)
REQUEST_DELAY=2
# Как представляться сайтам (по умолчанию — имя проекта со ссылкой на репозиторий)
USER_AGENT=
